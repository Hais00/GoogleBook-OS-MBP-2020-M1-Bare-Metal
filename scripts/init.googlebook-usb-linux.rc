# Native M1 USB ownership. The root init already mounts configfs at /config.
# Mode 2 leaves configuration to the AIDL HAL, excluding the platform's
# legacy android_usb (=0) and configfs-property (=1) writers.
on init
    setprop sys.usb.configfs 2

on post-fs-data
    mkdir /config/usb_gadget/g1 0770 root usb
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    write /config/usb_gadget/g1/bcdDevice 0x0100
    write /config/usb_gadget/g1/bcdUSB 0x0300
    mkdir /config/usb_gadget/g1/strings/0x409 0770 root usb
    write /config/usb_gadget/g1/strings/0x409/manufacturer "GoogleBook OS"
    write /config/usb_gadget/g1/strings/0x409/product "Apple M1 native USB"
    mkdir /config/usb_gadget/g1/configs/b.1 0770 root usb
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 root usb
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign MSFT100
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /config/usb_gadget/g1/functions/ffs.adb 0770 root usb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp 0770 root usb
    mkdir /config/usb_gadget/g1/functions/ffs.ptp 0770 root usb
    mkdir /config/usb_gadget/g1/functions/rndis.gs4 0770 root usb
    mkdir /config/usb_gadget/g1/functions/ncm.gs6 0770 root usb
    write /config/usb_gadget/g1/functions/rndis.gs4/os_desc/interface.rndis/compatible_id RNDIS
    write /config/usb_gadget/g1/functions/rndis.gs4/os_desc/interface.rndis/sub_compatible_id 5162001
    mkdir /dev/usb-ffs 0770 root usb
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mkdir /dev/usb-ffs/ptp 0770 mtp mtp
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mount functionfs mtp /dev/usb-ffs/mtp uid=1024,gid=1024,rmode=0770,fmode=0660
    mount functionfs ptp /dev/usb-ffs/ptp uid=1024,gid=1024,rmode=0770,fmode=0660

service vendor.usb-linux /vendor/bin/hw/android.hardware.usb-service.linux
    class hal
    user root
    group root system usb

service vendor.usb-gadget-linux /vendor/bin/hw/android.hardware.usb.gadget-service.linux
    class hal
    user root
    group root system usb mtp
