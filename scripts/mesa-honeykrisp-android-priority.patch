+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+VkResult
+hk_android_queues_init(struct hk_device *dev, const VkDeviceCreateInfo *info)
+{
+   unsigned count = 0;
+   for (unsigned i = 0; i < info->queueCreateInfoCount; i++)
+      count += info->pQueueCreateInfos[i].queueCount;
+   if (count <= 1) return VK_SUCCESS;
+   if (count > 2) return vk_error(dev, VK_ERROR_INITIALIZATION_FAILED);
+   const uint32_t needed = VK_SYNC_FEATURE_CPU_WAIT | VK_SYNC_FEATURE_WAIT_PENDING;
+   for (const struct vk_sync_type *const *type = dev->vk.physical->supported_sync_types; *type; type++)
+      if (((*type)->features & VK_SYNC_FEATURE_GPU_WAIT) &&
+          (((*type)->features & needed) != needed))
+         return vk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+   if (drmSyncobjCreate(dev->dev.fd, 0, &dev->android_submit.syncobj))
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   dev->android_submit.value = 1;
+   if (drmSyncobjTimelineSignal(dev->dev.fd, &dev->android_submit.syncobj,
+                               &dev->android_submit.value, 1))
+      return vk_error(dev, VK_ERROR_INITIALIZATION_FAILED);
+   simple_mtx_init(&dev->android_submit.lock, mtx_plain);
+   dev->android_submit.lock_ready = true;
+   vk_device_enable_threaded_submit(&dev->vk);
+   dev->android_submit.enabled = true;
+   return VK_SUCCESS;
+}
+
+void
+hk_android_queues_finish(struct hk_device *dev)
+{
+   /* Called only after every logical queue's submit worker has stopped. */
+   if (dev->android_submit.syncobj) {
+      drmSyncobjDestroy(dev->dev.fd, dev->android_submit.syncobj);
+      dev->android_submit.syncobj = 0;
+   }
+   if (dev->android_submit.lock_ready) {
+      simple_mtx_destroy(&dev->android_submit.lock);
+      dev->android_submit.lock_ready = false;
+   }
+}
+
+static VkResult
+hk_android_serialized_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
+{
+   struct hk_queue *queue = container_of(vk_queue, struct hk_queue, vk);
+   struct hk_device *dev = hk_queue_device(queue);
+   /* Crucially, never hold the global lock while waiting for a client signal.
+    * Another queue must be able to produce that signal later (binary/timeline).
+    * A per-queue Mesa worker makes this wait asynchronous to vkQueueSubmit. */
+   VkResult result = vk_sync_wait_many(&dev->vk, submit->wait_count, submit->waits,
+                                       VK_SYNC_WAIT_COMPLETE, UINT64_MAX);
+   if (result != VK_SUCCESS)
+      return vk_queue_set_lost(vk_queue, "Android client wait failed");
+   simple_mtx_lock(&dev->android_submit.lock);
+   int ret;
+   do {
+      ret = drmSyncobjTimelineWait(dev->dev.fd, &dev->android_submit.syncobj,
+                                   &dev->android_submit.value, 1, INT64_MAX,
+                                   DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL);
+   } while (ret && errno == EINTR);
+   if (ret) {
+      result = vk_queue_set_lost(vk_queue, "Android previous GPU completion wait failed");
+   } else {
+      result = hk_queue_submit(vk_queue, submit);
+      if (result == VK_SUCCESS) {
+         uint64_t next = dev->android_submit.value + 1;
+         if (!next || drmSyncobjTransfer(dev->dev.fd, dev->android_submit.syncobj, next,
+                                         queue->drm.syncobj, queue->drm.timeline_value, 0))
+            result = vk_queue_set_lost(vk_queue, "Android completion fence transfer failed");
+         else
+            dev->android_submit.value = next;
+      }
+   }
+   simple_mtx_unlock(&dev->android_submit.lock);
+   return result;
+}
+#endif
