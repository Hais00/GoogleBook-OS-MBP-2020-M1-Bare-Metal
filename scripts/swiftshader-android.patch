+    list(APPEND VULKAN_SRC_FILES VkDeviceMemoryExternalAndroid.cpp)
+endif()
+
 if(SWIFTSHADER_ENABLE_VULKAN_DEBUGGER)
     list(APPEND VULKAN_SRC_FILES
         Debug/Context.cpp
