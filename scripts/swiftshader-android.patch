     set(VULKAN_API_LIBRARY_NAME "libvulkan.dylib")
 elseif(FUCHSIA)
     set(VULKAN_API_LIBRARY_NAME "libvulkan.so")
+elseif(ANDROID)
+    set(VULKAN_API_LIBRARY_NAME "libvulkan.so")
 else()
     message(FATAL_ERROR "Platform does not support Vulkan yet")
 endif()
