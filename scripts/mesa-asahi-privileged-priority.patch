    /* Global queue handle */
    uint32_t queue_id;
+   enum drm_asahi_priority queue_priority;
 
    /* VMA heaps */
    simple_mtx_t vma_lock;
diff --git a/include/drm-uapi/asahi_drm.h b/include/drm-uapi/asahi_drm.h
--- a/include/drm-uapi/asahi_drm.h
+++ b/include/drm-uapi/asahi_drm.h
@@ -213,6 +213,14 @@
 	 * userspace can speculate memory accesses more aggressively.
 	 */
 	DRM_ASAHI_FEATURE_SOFT_FAULTS = (1UL) << 0,
+	/**
+	 * @DRM_ASAHI_FEATURE_PRIVILEGED_PRIORITY: HIGH and REALTIME queue
+	 * priorities are implemented and available to the current caller at
+	 * GET_PARAMS time. This requires CAP_SYS_NICE in the initial user
+	 * namespace. QUEUE_CREATE rechecks it; unauthorized callers get EACCES.
+	 * This reports kernel support, not a hard real-time completion guarantee.
+	 */
+	DRM_ASAHI_FEATURE_PRIVILEGED_PRIORITY = (1UL) << 1,
 };
 
 /**
@@ -538,14 +546,14 @@
 	/**
 	 * @DRM_ASAHI_PRIORITY_HIGH: High priority queue.
 	 *
-	 * Reserved for future extension.
+	 * Requires DRM_ASAHI_FEATURE_PRIVILEGED_PRIORITY and CAP_SYS_NICE.
 	 */
 	DRM_ASAHI_PRIORITY_HIGH = 2,
 
 	/**
 	 * @DRM_ASAHI_PRIORITY_REALTIME: Real-time priority queue.
 	 *
-	 * Reserved for future extension.
+	 * Requires DRM_ASAHI_FEATURE_PRIVILEGED_PRIORITY and CAP_SYS_NICE.
 	 */
 	DRM_ASAHI_PRIORITY_REALTIME = 3,
 };
