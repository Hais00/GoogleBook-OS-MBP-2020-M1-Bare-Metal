diff --git a/arch/arm64/tools/gen-kernel-hwcaps.sh b/arch/arm64/tools/gen-kernel-hwcaps.sh
index e7cdcf428..76663bcbb 100644
--- a/arch/arm64/tools/gen-kernel-hwcaps.sh
+++ b/arch/arm64/tools/gen-kernel-hwcaps.sh
@@ -17,7 +17,7 @@ echo "/* Generated file - do not edit */"
 echo ""
 
 grep -E '^#define HWCAP[0-9]*_[A-Z0-9_]+' $1 | \
-	sed 's/.*HWCAP\([0-9]*\)_\([A-Z0-9_]\+\).*/#define KERNEL_HWCAP_\2\t__khwcap\1_feature(\2)/'
+	sed 's/.*HWCAP\([0-9]*\)_\([A-Z0-9_][A-Z0-9_]*\).*/#define KERNEL_HWCAP_\2\t__khwcap\1_feature(\2)/'
 
 echo ""
 echo "#endif /* __ASM_KERNEL_HWCAPS_H */"
diff --git a/block/partitions/efi.c b/block/partitions/efi.c
index 9865d5909..2975897bf 100644
--- a/block/partitions/efi.c
+++ b/block/partitions/efi.c
@@ -747,6 +747,30 @@ int efi_partition(struct parsed_partitions *state)
 		label_max = min(ARRAY_SIZE(info->volname) - 1,
 				ARRAY_SIZE(ptes[i].partition_name));
 		utf16_le_to_7bit(ptes[i].partition_name, label_max, info->volname);
+
+		/* GoogleBook M1 installation: supply Android names for these
+		 * explicitly identified, unnamed partitions without rewriting GPT.
+		 * Existing names and every other partition remain unchanged.
+		 */
+		if (IS_ENABLED(CONFIG_ARCH_APPLE) && !info->volname[0]) {
+			static const struct {
+				const char *uuid;
+				const char *name;
+			} googlebook_parts[] = {
+				{ "00000000-0000-4000-8000-000000000001", "super" },
+				{ "00000000-0000-4000-8000-000000000004", "metadata" },
+				{ "00000000-0000-4000-8000-000000000005", "userdata" },
+			};
+			unsigned int p;
+
+			for (p = 0; p < ARRAY_SIZE(googlebook_parts); p++) {
+				if (!strcasecmp(info->uuid, googlebook_parts[p].uuid)) {
+					strscpy(info->volname, googlebook_parts[p].name,
+						sizeof(info->volname));
+					break;
+				}
+			}
+		}
 		state->parts[i + 1].has_info = true;
 	}
 	kfree(ptes);
diff --git a/scripts/Makefile.vmlinux b/scripts/Makefile.vmlinux
