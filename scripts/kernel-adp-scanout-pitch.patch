diff --git a/drivers/gpu/drm/adp/adp_drv.c b/drivers/gpu/drm/adp/adp_drv.c
index 4554cf755..00e5f06a9 100644
--- a/drivers/gpu/drm/adp/adp_drv.c
+++ b/drivers/gpu/drm/adp/adp_drv.c
@@ -10,6 +10,7 @@
 #include <drm/drm_bridge.h>
 #include <drm/drm_bridge_connector.h>
 #include <drm/drm_drv.h>
+#include <drm/drm_dumb_buffers.h>
 #include <drm/drm_fb_dma_helper.h>
 #include <drm/drm_framebuffer.h>
 #include <drm/drm_gem_atomic_helper.h>
@@ -93,10 +94,24 @@ static int adp_drm_gem_dumb_create(struct drm_file *file_priv,
 					struct drm_device *drm,
 					struct drm_mode_create_dumb *args)
 {
+	int ret;
+
+	/* Keep the existing allocation-height padding and report an aligned
+	 * scanline pitch to every dumb-buffer client. A 60-pixel XRGB8888
+	 * scanline needs 256 bytes of storage with this alignment, not 240.
+	 */
+	if (args->height > U32_MAX - 63)
+		return -EINVAL;
 	args->height = ALIGN(args->height, 64);
-	args->size = args->pitch * args->height;
+	ret = drm_mode_size_dumb(drm, args, 64, 0);
+	if (ret)
+		return ret;
 
-	return drm_gem_dma_dumb_create_internal(file_priv, drm, args);
+	ret = drm_gem_dma_dumb_create_internal(file_priv, drm, args);
+	if (!ret)
+		drm_info_once(drm, "scanout allocation %ux%u pitch=%u bytes size=%llu\n",
+			      args->width, args->height, args->pitch, args->size);
+	return ret;
 }
 
 static const struct drm_driver adp_driver = {
