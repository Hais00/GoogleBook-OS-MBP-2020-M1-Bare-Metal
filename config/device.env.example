# Schematic development configuration. No real machine identifiers are published.
# Replace the examples and adapt legacy recipes before any installation.
GOS_SUPER_PARTUUID=00000000-0000-4000-8000-000000000001
GOS_BOOT_PARTUUID=00000000-0000-4000-8000-000000000002
GOS_ESP_PARTUUID=00000000-0000-4000-8000-000000000003
GOS_METADATA_PARTUUID=00000000-0000-4000-8000-000000000004
GOS_USERDATA_PARTUUID=00000000-0000-4000-8000-000000000005
GOS_BUILD_VOLUME=/opt/googlebook/build
GOS_LARGE_WORK=/opt/googlebook/external/work
M1N1DEVICE=/dev/ttyACM0
